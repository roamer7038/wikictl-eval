index 0000000..83c0ebe
--- /dev/null
+++ b/internal/repo/proto.go
@@ -0,0 +1,37 @@
+package repo
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// Head returns the commit that the reads of r use, or "" before Snapshot or
+// when the branch does not exist.
+func (r *Repo) Head() string { return r.snapshot }
+
+// Archive writes a tar archive of the files under paths (the whole tree
+// without paths) at the commit of Head to w.
+func (r *Repo) Archive(w io.Writer, paths []string) error {
+	args := append([]string{"archive", "--format=tar", r.snapshot}, pathspec(paths)...)
+	c := r.command(nil, args)
+	c.Stdout = w
+	c.Stderr = io.Discard
+	return c.Run()
+}
+
+// FetchedWithin reports whether the last Fetch recorded by MarkFetched ended
+// less than ttl ago.
+func (r *Repo) FetchedWithin(ttl time.Duration) bool {
+	st, err := os.Stat(filepath.Join(r.Dir, "wikictl-fetched"))
+	return err == nil && time.Since(st.ModTime()) < ttl
+}
+
+// MarkFetched records the time of a successful Fetch.
+func (r *Repo) MarkFetched() {
+	p := filepath.Join(r.Dir, "wikictl-fetched")
+	if f, err := os.Create(p); err == nil {
+		f.Close()
+	}
+}
